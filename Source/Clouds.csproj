<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>Clouds</RootNamespace>
		<AssemblyName>Clouds</AssemblyName>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<OutputPath>..\1.7\Assemblies\</OutputPath>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<AssetTargetFallback>$(AssetTargetFallback);net472</AssetTargetFallback>
		<Version>$(ModVersion)</Version>
		<AssemblyVersion>$(ModVersion)</AssemblyVersion>
		<FileVersion>$(ModVersion)</FileVersion>
		<PackageVersion>$(ModVersion)</PackageVersion>
		<InformationalVersion>$(ModVersion)</InformationalVersion>
		<Company>Brrainz</Company>
		<Authors>Andreas Pardeike</Authors>
		<Copyright>Copyright Andreas Pardeike</Copyright>
		<PackageProjectUrl>$(Repository)</PackageProjectUrl>
		<RepositoryUrl>$(Repository)</RepositoryUrl>
		<Product>$(ModName)</Product>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DebugSymbols>false</DebugSymbols>
		<Optimize>true</Optimize>
		<DebugType>none</DebugType>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DebugSymbols>true</DebugSymbols>
		<DefineConstants>TRACE;DEBUG</DefineConstants>
		<Optimize>false</Optimize>
		<DebugType>portable</DebugType>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Brrainz.RimWorld.CrossPromotion" Version="1.1.2" NoWarn="NU1701" />
		<Compile Remove="BridgeTools\**\*.cs" />
		<None Include="BridgeTools\**\*" />
		<Content Include="..\Directory.Build.props">
			<Link>%(Filename)%(Extension)</Link>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.5021-unstable" />
		<PackageReference Include="Lib.Harmony.Ref" Version="3.0.0-rc.8" />
		<PackageReference Include="Krafs.Publicizer" Version="2.3.2" PrivateAssets="all" />
		<Publicize Include="Assembly-CSharp" />
	</ItemGroup>
	<Target Name="RestoreBridgeTools" BeforeTargets="Build" Condition="'$(BuildBridgeTools)' != 'false' And ('$(RIMWORLD_MOD_DIR)' == '' Or '$(RimworldDeployGuardInner)' == 'true')">
		<Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; restore &quot;$(MSBuildProjectDirectory)\BridgeTools\Clouds.BridgeTools.csproj&quot; --nologo --verbosity quiet" />
	</Target>

	<Target Name="BuildBridgeTools" DependsOnTargets="RestoreBridgeTools" AfterTargets="Build" BeforeTargets="StageMod;_CopyToRimworldUnlocked" Condition="'$(BuildBridgeTools)' != 'false' And ('$(RIMWORLD_MOD_DIR)' == '' Or '$(RimworldDeployGuardInner)' == 'true')">
		<MSBuild Projects="$(MSBuildProjectDirectory)\BridgeTools\Clouds.BridgeTools.csproj" Targets="Build"
			Properties="Configuration=$(Configuration);Platform=$(Platform);CloudsAssemblyPath=$(TargetPath)" />
	</Target>

	<Target Name="StageMod" AfterTargets="Build" DependsOnTargets="BuildBridgeTools" Condition="'$(RimworldDeployGuardInner)' != 'true'">
		<Exec Command="python3 &quot;$(MSBuildProjectDirectory)\..\scripts\stage-mod.py&quot; &quot;$(TargetPath)&quot;" />
	</Target>

	<Target Name="SyncModMetadata" BeforeTargets="StageMod">
		<XmlPoke XmlInputPath="$(MSBuildProjectDirectory)\..\About\About.xml" Query="//ModMetaData/modVersion" Value="$(ModVersion)" />
		<XmlPoke XmlInputPath="$(MSBuildProjectDirectory)\..\About\Manifest.xml" Query="//Manifest/version" Value="$(ModVersion)" />
	</Target>

	<Target Name="ValidateRimworldDeployRoot" BeforeTargets="Build;CopyToRimworld" Condition="'$(RIMWORLD_MOD_DIR)' != '' And '$(RimworldDeployGuardInner)' != 'true'">
		<Exec Command="&quot;$(MSBuildProjectDirectory)\..\scripts\rimworld-deploy-guard.sh&quot; validate &quot;$(RIMWORLD_MOD_DIR)&quot; &quot;$(MSBuildProjectFullPath)&quot; &quot;$(ModFileName)&quot; &quot;$(BuildBridgeTools)&quot;" />
	</Target>

	<Target Name="CopyToRimworld" AfterTargets="StageMod" Condition="'$(RIMWORLD_MOD_DIR)' != '' And '$(RimworldDeployGuardInner)' != 'true'">
		<Exec Command="&quot;$(MSBuildProjectDirectory)\..\scripts\rimworld-deploy-guard.sh&quot; deploy &quot;$(RIMWORLD_MOD_DIR)&quot; &quot;$(MSBuildProjectFullPath)&quot; &quot;$(Configuration)&quot; &quot;$(Platform)&quot; &quot;$(ModFileName)&quot; &quot;$(BuildBridgeTools)&quot;" />
	</Target>

	<Target Name="_CopyToRimworldUnlocked" Condition="'$(RIMWORLD_MOD_DIR)' != '' And '$(RimworldDeployGuardInner)' == 'true'">
		<Exec Command="python3 &quot;$(MSBuildProjectDirectory)\..\scripts\stage-mod.py&quot; --install-unlocked &quot;$(RIMWORLD_MOD_DIR)&quot; &quot;$(BuildBridgeTools)&quot;" />
	</Target>

	<Target Name="ZipMod" DependsOnTargets="StageMod;CopyToRimworld" />

</Project>
